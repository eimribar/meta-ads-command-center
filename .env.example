# Settings for Meta Ads Command Center.
# Copy this file to .env and fill it in as you go through docs/INSTALL.md.
# docs/SETTINGS.md explains every line. Never commit .env.
# Write values without quotes (docker run --env-file passes quotes through as part of the value),
# and never use # inside a value: an unquoted # starts a comment and cuts the value off.
# The commented lines are optional; each shows its default. Remove the # in front to change one.
# On and off settings take true or false.

# ── Database (step 2 of the install) ─────────────────────────────────
# Any Postgres, like postgres://agent:password@localhost:5432/agent. URL-encode special
# characters in the password (# is %23, @ is %40). Leave it empty with docker compose: it brings
# its own.
DATABASE_URL=
# auto, require, verify or disable
# DATABASE_SSL=auto
# The path to your provider's CA certificate file, for DATABASE_SSL=verify
# DATABASE_SSL_CA=

# ── Meta (step 3) ────────────────────────────────────────────────────
META_ACCESS_TOKEN=
# The ad account id, like act_1234567890
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
# Found from the Page; set it only if that fails
# META_IG_USER_ID=
# META_API_VERSION=v25.0
# Campaign ids separated by commas; empty means the whole ad account
# CAMPAIGN_ALLOWLIST=

# ── What counts as a result (step 3) ─────────────────────────────────
# For example Purchase, Lead or Schedule, and the word your team uses for it
RESULT_EVENT=
RESULT_LABEL=
SECONDARY_EVENT=
SECONDARY_LABEL=
# The exact action types to count, only when the check says the mapping picked the wrong one
# RESULT_ACTION_TYPE=
# SECONDARY_ACTION_TYPE=

# ── Your numbers, in the ad account's currency (from whoever owns the ad budget) ──
TARGET_COST_PER_RESULT=
MAX_DAILY_BUDGET=

# ── Slack (step 4) ───────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# The channel id, starting with C (not #name)
SLACK_CHANNEL=
ADMIN_SLACK_USER_IDS=

# ── Claude (step 5) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# MODEL=claude-opus-5-5
# low, medium, high, xhigh or max
# MODEL_EFFORT=high
# WEB_RESEARCH_ENABLED=true

# ── Schedule (step 9) ────────────────────────────────────────────────
# An IANA time zone name; empty means the ad account's time zone
# TIMEZONE=
# false turns the timers off; run npm run job -- <name> from your own scheduler
# INTERNAL_SCHEDULER=true
# REPORT_ENABLED=true
# REPORT_TIME=09:00
# false turns the optimizer off everywhere (timers, npm run job, optimize in Slack)
# OPTIMIZER_ENABLED=true
# OPTIMIZER_TIME=08:45
# OPTIMIZER_EVERY_HOURS=6
# WEEKLY_DAY=monday

# ── Comment moderation ───────────────────────────────────────────────
# MODERATION_ENABLED=true
# MODERATION_EVERY_MINUTES=60
# hide, delete or flag
# MODERATION_ACTION=hide
# MODERATION_MIN_CONFIDENCE=0.7

# ── Process ──────────────────────────────────────────────────────────
# The health endpoint, GET /health
# PORT=3000
# With it set, GET /health with the header x-health-secret returns job health as JSON
# HEALTH_SECRET=
